{
  "name": "coherent-client-kit",
  "version": "0.0.23",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./mithril": {
      "import": "./dist/mithril.mjs",
      "require": "./dist/mithril.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "esbuild": "^0.27.3"
  }
}
